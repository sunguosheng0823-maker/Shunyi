<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>cn.wkkj.shunyi.agent</string>
  <key>ProgramArguments</key><array><string>/usr/local/bin/rc-agent</string><string>run</string></array>
  <key>EnvironmentVariables</key><dict>
    <key>UNIRC_SERVER</key><string>wss://relay.example.com</string>
    <key>UNIRC_STATE_DIR</key><string>/Users/REPLACE_USER/.shunyi</string>
    <key>UNIRC_SHELL</key><string>/bin/zsh</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
</dict></plist>
