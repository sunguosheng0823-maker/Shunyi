[Unit]
Description=Shunyi TLS tunnel relay
After=network-online.target

[Service]
Type=simple
User=shunyi-relay
EnvironmentFile=/etc/shunyi/relay.env
ExecStart=/usr/local/bin/rc-server
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
