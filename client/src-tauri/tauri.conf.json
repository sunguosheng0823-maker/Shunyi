{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "瞬移",
  "version": "0.1.0",
  "identifier": "cn.wkkj.shunyi",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://127.0.0.1:5181",
    "beforeDevCommand": "npm --prefix ../ui run dev -- --host 127.0.0.1 --port 5181 --strictPort",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "瞬移终端",
        "label": "main",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
